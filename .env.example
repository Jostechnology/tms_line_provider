# ─── Core Service ─────────────────────────────────────────────────────────────
ADMIN_TOKEN=
SERVICE_BASE_URL=

# ─── Center Service ───────────────────────────────────────────────────────────
CENTER_ACCESS_KEY=
CENTER_URL=

# ─── Database ─────────────────────────────────────────────────────────────────
# Docker:  postgresql://postgres:password@host.docker.internal:5432/tms_line_db
# Local:   postgresql://postgres:password@localhost:5432/tms_line_db
DATABASE_URL=

# ─── LINE OAuth ───────────────────────────────────────────────────────────────
# From LINE Developers Console → LINE Login channel → Basic Settings
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Public URL of this auth server — use ngrok for local dev
# e.g. https://xxxx.ngrok-free.app
AUTH_SERVER_URL=

# ─── TMS Integration ──────────────────────────────────────────────────────────
# URL of tms-line-provider (this service) — used by mock auth server callback
# Docker: http://tms-line-provider:5002
# Local:  http://localhost:5002
TMS_LINE_PROVIDER_URL=
