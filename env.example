ADMIN_TOKEN=ADMIN_TOKEN123
# Public base URL of this service. Hosts both LINE webhooks and the OAuth
# callback ({SERVICE_BASE_URL}/auth/line/callback) — must be publicly reachable
# and registered as the callback URL in the LINE Login channel.
SERVICE_BASE_URL=http://localhost:5002
DATABASE_URL=sqlite:///./line_tms.db
# LINE Login channel credentials (account-linking OAuth)
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=