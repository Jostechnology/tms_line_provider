# Center Service
CENTER_ACCESS_KEY=
CENTER_URL=

# Admin token — used to authenticate internal API calls
ADMIN_TOKEN=

# Base URL of this service — used to build webhook URLs
# Local dev:    http://localhost:5002
# ngrok:        https://your-ngrok-subdomain.ngrok-free.dev
# Production:   https://your-domain.com
SERVICE_BASE_URL=

# PostgreSQL connection string
# Local:        postgresql://postgres:password@localhost:5432/tms_line_db
# Docker:       postgresql://postgres:password@host.docker.internal:5432/tms_line_db
DATABASE_URL=

# Redis (leave as-is for Docker)
REDIS_URL=redis://redis:6379/0

# Tracking mode: fixture (dev) or proxy (production)
TRACKING_MODE=fixture
TMS_TRACKING_URL=
